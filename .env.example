# Copy to .env and adjust. Read by docker-compose.yml.

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Routing server (public OSRM demo by default)
OSRM_URL=https://router.project-osrm.org

# Single URL for the whole app: http://localhost:8080 (API under /api/)
APP_PORT=8080
